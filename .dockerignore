# Build artifacts and deps (reinstalled/rebuilt inside the image)
**/node_modules
**/dist
**/.turbo

# VCS / editor / local tooling
.git
.gitignore
.serena
.worktrees
.vscode
.idea

# Secrets and local env (never bake into an image)
**/.env
**/.env.*
