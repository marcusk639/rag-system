# Build artifacts and deps (reinstalled/rebuilt inside the image)
**/node_modules
**/dist
**/.turbo
**/.next

# Frontend app: the backend service images (api/worker/mcp) must not bundle or
# build the Next.js chat UI. Excluding it also keeps the workspace `pnpm install
# --frozen-lockfile` to the 13 backend projects (apps/web deps are intentionally
# not in the root lockfile yet).
apps/web

# VCS / editor / local tooling
.git
.gitignore
.serena
.worktrees
.scratch*
.remember
.vscode
.idea

# Secrets and local env (never bake into an image)
**/.env
**/.env.*
!**/.env.example

# Local data and logs
postgres-data
**/*.log

# Docs and scratch (not needed to build/run) — except docs/compliance, which
# the COMPLIANCE_MODE=client-data boot gate reads at runtime (see
# packages/core/src/config.ts's defaultCheckDpa).
docs/*
!docs/compliance
*.md
!README.md
!docs/compliance/*.md
sesh.sh
PATHFINDER-*
journey-into-rag-system.md
