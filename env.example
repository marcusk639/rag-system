# Copy this file to .env and fill in values.
# (Hosted Claude Code cannot create .env files for you — copy manually.)

# Pino log level for all Node services (api, mcp, worker): trace|debug|info|warn|error
LOG_LEVEL=info

# ============================================================================
# Database
# ============================================================================
DATABASE_URL=postgres://rag:rag@localhost:5432/rag
PG_BOSS_SCHEMA=pgboss

# ============================================================================
# Embedding Provider
# Default: gemini (free tier, 768-dim text-embedding-004).
# Alternatives: openai (text-embedding-3-small, 1536-dim), local (transformers.js, 768-dim bge-small)
# ============================================================================
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# Provider API keys (only the configured provider's key is required)
GEMINI_API_KEY=
OPENAI_API_KEY=

# ============================================================================
# Document Parser Sidecar
# ============================================================================
PARSER_URL=http://localhost:8000
PARSER_TIMEOUT_MS=60000
# Hard cap on upload size accepted by the parser sidecar (bytes). Default 100 MB.
PARSER_MAX_UPLOAD_BYTES=104857600

# ============================================================================
# API Server
# ============================================================================
API_PORT=3000
API_HOST=0.0.0.0
# Bearer tokens authorized to call the API (comma-separated).
# Each PLAIN token here resolves to an ADMIN / all-access principal:
# retrieval is UNRESTRICTED (sees the whole corpus). Reserve these for
# admin/service callers. Backward-compatible with the pre-ACL behavior.
API_TOKENS=dev-token-change-me

# SCOPED principals (per-token sourceId access control) — OPT-IN confidentiality
# boundary. JSON array of {"token","allowedSourceIds":[...]}. A token listed
# here is a valid bearer token but retrieval is ENFORCED to ONLY its
# allowedSourceIds (and CANNOT see anything else); an empty array => the token
# can read NOTHING (fail closed). Scoped wins over API_TOKENS if a token appears
# in both (least privilege). Used by both the HTTP API and the MCP HTTP
# transport. Leave blank for no scoped principals. Example:
# API_PRINCIPALS=[{"token":"staff-a-token","allowedSourceIds":["<source-uuid-1>","<source-uuid-2>"]}]
API_PRINCIPALS=

# ============================================================================
# MCP Server
# ============================================================================
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3001
# Comma-separated allowlist of Origins for the MCP HTTP transport (DNS-rebinding
# protection). Leave blank to allow all origins (development only).
MCP_ALLOWED_ORIGINS=
# Max concurrent MCP sessions held in memory on the HTTP transport.
MCP_MAX_SESSIONS=1000

# ============================================================================
# Worker
# ============================================================================
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=2000

# ============================================================================
# Microsoft (SharePoint + Outlook)
# App registration: https://entra.microsoft.com → App registrations
# Needs Application permissions: Sites.Read.All, Files.Read.All, Mail.Read
# ============================================================================
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ============================================================================
# Google (Drive + Gmail)
# Service account JSON OR OAuth client credentials.
# For Workspace-wide access, use a service account with domain-wide delegation.
# ============================================================================
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or OAuth:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ============================================================================
# Retrieval tuning
# ============================================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=120
DEFAULT_TOP_K=8
HYBRID_DENSE_WEIGHT=0.7
HYBRID_SPARSE_WEIGHT=0.3

# ============================================================================
# Optional: generation model for /ask endpoint
# ============================================================================
GENERATION_PROVIDER=gemini
GENERATION_MODEL=gemini-2.5-flash
