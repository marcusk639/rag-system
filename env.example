# Copy this file to .env and fill in values.
# (Hosted Claude Code cannot create .env files for you — copy manually.)

# Pino log level for all Node services (api, mcp, worker): trace|debug|info|warn|error
LOG_LEVEL=info

# ============================================================================
# Database
# Also consumed directly by apps/web (src/lib/db.ts) for the admin
# access-grant/revoke server actions — the web app now needs its own DB
# connectivity, not just a token to call the API.
# ============================================================================
DATABASE_URL=postgres://rag:rag@localhost:5432/rag
PG_BOSS_SCHEMA=pgboss
# Optional TLS for the app's Postgres pool: require (verify cert) | no-verify
# (TLS but accept managed/self-signed certs) | disable/unset (no explicit pool
# TLS). In production, if neither this nor ?sslmode=require is set, startup logs
# a warning. For uniform coverage (pool + pg-boss + migrations) prefer adding
# ?sslmode=require to DATABASE_URL instead of this flag.
DATABASE_SSL=

# ============================================================================
# Embedding Provider
#
# COMPLIANCE MODE (CPA/§7216): set EMBEDDING_PROVIDER=local so embeddings are
# generated on-process via ONNX (no TRI egress, satisfies CR-1 and CR-3).
#
# local   — @huggingface/transformers, ONNX runtime, zero network egress.
#            Default model: Xenova/bge-base-en-v1.5 (768-d). ~430 MB on first
#            startup; run `npx tsx scripts/warm-model.ts` during image build to
#            pre-warm. Subsequent runs use HF_CACHE_DIR (no download).
# gemini  — Gemini embedding API (768-d via outputDimensionality). Requires
#            GEMINI_API_KEY. Note: text-embedding-004 is retired; use
#            gemini-embedding-001.
# openai  — OpenAI text-embedding-3-small (1536-d). Requires OPENAI_API_KEY.
# ============================================================================
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Local provider only — override the HuggingFace model cache directory.
# Defaults to ~/.cache/huggingface. Set to a shared path on deployment VMs to
# avoid re-downloading weights on every deploy.
HF_CACHE_DIR=

# Provider API keys (only the configured provider's key is required)
GEMINI_API_KEY=
OPENAI_API_KEY=

# ============================================================================
# Document Parser Sidecar
# ============================================================================
PARSER_URL=http://localhost:8000
PARSER_TIMEOUT_MS=60000
# Hard cap on upload size accepted by the parser sidecar (bytes). Default 100 MB.
PARSER_MAX_UPLOAD_BYTES=104857600
# Optional shared secret for the parser sidecar. When set, the sidecar requires
# an X-Parser-Token header matching this value and the Node client sends it.
# Leave blank for single-host dev (the loopback bind is the only guard).
# REQUIRED (fail-loud at startup) when NODE_ENV=production — every service
# (api/mcp/worker) AND the parser sidecar must share the same value, or the
# parser returns 401. Generate with: openssl rand -hex 32
PARSER_SECRET=

# ============================================================================
# Observability — Error Reporting (Sentry-compatible)
# Set SENTRY_DSN to enable error capture in api, mcp, worker, and parser.
# Safe to omit in dev/CI. Find your DSN at: https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=

# ============================================================================
# Object Storage (original document bytes for downloadable citations)
# Default: none (originals are NOT stored; the download route returns 404).
# Set provider=s3 to persist originals to any S3-compatible store
# (AWS S3, Railway buckets, MinIO, GCS S3-mode) so users can download the
# exact cited file. Switching this on only affects documents synced afterward.
# ============================================================================
OBJECT_STORE_PROVIDER=none
OBJECT_STORE_BUCKET=
# Custom endpoint for non-AWS stores (e.g. a Railway bucket or MinIO URL).
# Leave blank for real AWS S3.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
# Path-style addressing — required by most non-AWS S3-compatible stores.
OBJECT_STORE_FORCE_PATH_STYLE=true
# Optional prefix applied to every stored object key (e.g. "originals/").
OBJECT_STORE_KEY_PREFIX=

# ============================================================================
# API Server
# ============================================================================
API_PORT=3000
API_HOST=0.0.0.0
# Bearer tokens authorized to call the API (comma-separated).
# Each PLAIN token here resolves to an ADMIN / all-access principal:
# retrieval is UNRESTRICTED (sees the whole corpus). Reserve these for
# admin/service callers. Backward-compatible with the pre-ACL behavior.
# If a token/secret value might itself contain a comma, use a JSON array
# instead, e.g. ["token,with,comma","plain-token"].
API_TOKENS=dev-token-change-me

# SCOPED principals (per-token sourceId access control) — OPT-IN confidentiality
# boundary. JSON array of {"token","allowedSourceIds":[...]}. A token listed
# here is a valid bearer token but retrieval is ENFORCED to ONLY its
# allowedSourceIds (and CANNOT see anything else); an empty array => the token
# can read NOTHING (fail closed). Scoped wins over API_TOKENS if a token appears
# in both (least privilege). Used by both the HTTP API and the MCP HTTP
# transport. Leave blank for no scoped principals. Example:
# API_PRINCIPALS=[{"token":"staff-a-token","allowedSourceIds":["<source-uuid-1>","<source-uuid-2>"]}]
# Grant explicit all-corpus admin with {"token":"...","allowedSourceIds":[],"isAdmin":true}.
API_PRINCIPALS=
# OPT-IN least-privilege enforcement. When true, plain API_TOKENS no longer grant
# admin — they authenticate but resolve to deny-all; admin must be granted
# explicitly via an isAdmin principal above. Default false keeps API_TOKENS=admin
# (backward compatible). Recommended: set true in production once admins are
# moved to isAdmin principals.
API_ENFORCE_SCOPING=false

# ============================================================================
# Authentication provider (pluggable, IdP-NEUTRAL)
# ============================================================================
# Selects how bearer credentials are authenticated. The core is provider-neutral:
# everything below is DEPLOYMENT config — no IdP is hardcoded.
#   static-token  Only API_TOKENS / API_PRINCIPALS (legacy behavior).
#   oidc          Only OIDC JWTs (federated identity).
#   composite     Both: static tokens AND OIDC JWTs (default). Static is tried
#                 first; OIDC second. With no OIDC_* vars set, composite behaves
#                 exactly like static-token (backward compatible).
AUTH_PROVIDER=composite

# --- Generic OIDC settings (used when AUTH_PROVIDER is oidc or composite) ---
# Leave OIDC_ISSUER/OIDC_AUDIENCE blank to disable OIDC under composite. Setting
# AUTH_PROVIDER=oidc without these fails loud at startup.
#
# OIDC_ISSUER     Expected `iss` claim — the IdP issuer URL.
# OIDC_AUDIENCE   Expected `aud` claim — THIS API's app/client id at the IdP.
# OIDC_JWKS_URI   JWKS endpoint. Optional; if blank we derive
#                 <issuer>/.well-known/jwks.json. Most IdPs use a custom path,
#                 so set this explicitly when in doubt.
# OIDC_CLAIM      Token claim carrying the caller's group/role ids. May be a
#                 string or string[] in the token. Default: groups
# OIDC_SCOPE_MAP  JSON array mapping a claim VALUE to allowed source ids. The
#                 union across all matching entries is the caller's scope. A
#                 token with no matching entry sees NOTHING (fail closed).
# OIDC_ADMIN_CLAIMS  Claim values granting ADMIN / all-access. JSON array or CSV.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_CLAIM=groups
OIDC_SCOPE_MAP=
OIDC_ADMIN_CLAIMS=
#
# --- Example: Microsoft Entra ID (Azure AD) ---
# Entra is just one OIDC IdP; the core has zero Entra-specific code. To wire it,
# set (replace <tenant-id> and <api-client-id>):
#   OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#   OIDC_AUDIENCE=<api-client-id>
#   OIDC_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
#   OIDC_CLAIM=groups
#   OIDC_SCOPE_MAP=[{"claim":"<entra-group-object-id>","allowedSourceIds":["<source-uuid-1>"]}]
#   OIDC_ADMIN_CLAIMS=["<entra-admin-group-object-id>"]

# ============================================================================
# Internal scope-assertion tokens (web app BFF -> Fastify)
# Comma-separated secrets verifying BFF-minted per-user scope tokens (see
# InternalScopeAuthProvider). Multiple values support rotation without
# downtime. Requires AUTH_PROVIDER=composite to take effect. Store the actual
# value in a real secret manager, not a plaintext deploy dashboard field.
# If a token/secret value might itself contain a comma, use a JSON array
# instead, e.g. ["secret,with,comma","plain-secret"].
# CRITICAL: Each secret must be at least 64 hex characters (256 bits of
# entropy for HS256). Generate with: openssl rand -hex 32
# ============================================================================
INTERNAL_SCOPE_JWT_SECRETS=

# INTERNAL_SCOPE_JWT_SECRET (singular) — apps/web only (src/lib/scope-token.ts).
# The ONE secret the web app's BFF uses to SIGN scope-assertion tokens. It
# MUST be one of the comma-separated values listed in INTERNAL_SCOPE_JWT_SECRETS
# above (which is what the api/mcp side uses to VERIFY them) — if it isn't,
# every scope-assertion token the web app mints will be rejected and every
# BFF-forwarded request will fail. Store in a real secret manager.
# CRITICAL: Must be at least 64 hex characters (256 bits of entropy for HS256).
# Generate with: openssl rand -hex 32
INTERNAL_SCOPE_JWT_SECRET=

# ============================================================================
# MCP Server
# ============================================================================
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3001
# Comma-separated allowlist of Origins for the MCP HTTP transport (DNS-rebinding
# protection). Leave blank to allow all origins (development only).
MCP_ALLOWED_ORIGINS=
# Max concurrent MCP sessions held in memory on the HTTP transport.
MCP_MAX_SESSIONS=1000

# ============================================================================
# Worker
# ============================================================================
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=2000

# ============================================================================
# Microsoft (SharePoint + Outlook)
# App registration: https://entra.microsoft.com → App registrations
# Needs Application permissions: Sites.Read.All, Files.Read.All, Mail.Read
# ============================================================================
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ============================================================================
# Google (Drive + Gmail)
# Service account JSON OR OAuth client credentials.
# For Workspace-wide access, use a service account with domain-wide delegation.
# ============================================================================
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or OAuth:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ============================================================================
# Retrieval tuning
# ============================================================================
# NOTE: when EMBEDDING_PROVIDER=local, the effective chunk size is capped at
# 512 tokens regardless of this value — Xenova/bge-base-en-v1.5 (the only
# provider allowed under COMPLIANCE_MODE=client-data) hard-truncates at 512
# tokens, so anything larger was previously embedded with silent, invisible
# retrieval-quality loss. Setting CHUNK_SIZE above 512 with the local provider
# logs a startup warning and is capped automatically; any individual chunk
# that still exceeds 512 tokens after the cap (e.g. one anomalous long
# paragraph) is embedded with a logged runtime warning rather than a silent
# or fatal failure.
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# Number of chunks retrieved per query (default 12). Larger = more context for
# the generator, more tokens. Pair with GENERATION_MAX_OUTPUT_TOKENS.
DEFAULT_TOP_K=12
HYBRID_DENSE_WEIGHT=0.7
HYBRID_SPARSE_WEIGHT=0.3
# Per-document diversity cap: at most N chunks from any single document reach
# the generator, so one long file can't crowd out other sources. 0 disables.
MAX_CHUNKS_PER_DOCUMENT=3

# ============================================================================
# Optional: reranking stage (Phase F)
# After hybrid RRF fusion, an optional cross-encoder reranker re-orders the
# over-fetched candidate pool by true query relevance before the top-K reaches
# the generator. `none` (default) is a pass-through — deployments opt in.
# ============================================================================
#
# ⚠ A hosted reranker is an EGRESS EVENT. It sends the retrieved chunk TEXT —
# firm document content — to the provider. It is gated on the same
# EGRESS_ALLOWED_HOSTS allow-list as embeddings, generation, and audit-log
# shipping, so setting RERANK_PROVIDER alone is NOT enough: you must also add
# the provider host, or every rerank call throws EgressError and retrieval
# degrades (silently, by design) to the un-reranked RRF order.
#   cohere -> api.cohere.com
#   jina   -> api.jina.ai
# That extra step is deliberate: it is the point at which someone confirms a DPA
# is on file for this vendor. It is not a nuisance to work around.
#
# none | cohere | jina (llm reserved, not yet implemented)
RERANK_PROVIDER=none
# Provider model (defaults: cohere=rerank-v3.5, jina=jina-reranker-v2-base-multilingual).
# Both defaults are current and un-deprecated as of 2026-08-01, though each
# vendor has newer models (cohere rerank-v4.0-*, jina-reranker-v3.5).
RERANK_MODEL=
# API key for the hosted reranker (required when provider != none).
# ⚠ Check the key's TIER before a pilot: a Cohere TRIAL key is limited to
# 10 requests/minute (production keys: 1,000/min). Exhausting it surfaces as
# rerank failures that fall back to RRF order without failing the query — i.e.
# reranking quietly stops happening rather than erroring visibly.
RERANK_API_KEY=
# Candidates pulled from hybrid search = RERANK_POOL_MULTIPLIER × topK
RERANK_POOL_MULTIPLIER=5

# ============================================================================
# Compliance enforcement mode (§7216 / CPA deployment)
#
# none         — default; no extra startup checks. Use in dev and CI.
# client-data  — service refuses to boot unless docs/compliance/vendor-dpa-<vendor>.md
#                exists. Use in any environment where real firm/taxpayer documents
#                may enter the pipeline. Create the DPA file first
#                (see docs/compliance/README.md), then set this.
# ============================================================================
COMPLIANCE_MODE=none

# ============================================================================
# Egress allow-list (CR-1 / §7216 compliance)
# Comma-separated hostnames that generation calls are permitted to reach.
# If empty, all external generation calls are blocked (local-only mode).
# Example: generativelanguage.googleapis.com,api.openai.com
# In COMPLIANCE_MODE=client-data leave blank unless a signed DPA is on file for
# each listed host (see docs/compliance/).
# ============================================================================
EGRESS_ALLOWED_HOSTS=generativelanguage.googleapis.com,api.openai.com

# ============================================================================
# Optional: generation model for /ask endpoint
# ============================================================================
GENERATION_PROVIDER=gemini
GENERATION_MODEL=gemini-2.5-flash
# Upper bound on generated answer length. Generous so substantive, multi-source
# answers aren't truncated at provider defaults.
GENERATION_MAX_OUTPUT_TOKENS=2048

# Self-hosted, OpenAI-compatible generation endpoint (Ollama, vLLM, LM Studio,
# llama.cpp). Set this to keep prompt text on the client's network; pair with
# EMBEDDING_PROVIDER=local for a deployment that makes no outbound calls.
# Requires GENERATION_PROVIDER=openai — gemini + this throws at startup rather
# than silently calling Google.
# The host below MUST also appear in EGRESS_ALLOWED_HOSTS or every call throws.
# See docs/LOCAL-GENERATION.md.
# GENERATION_BASE_URL=http://127.0.0.1:11434/v1

# API key for generation. When unset it falls back to the embedding provider's
# key (GEMINI_API_KEY or OPENAI_API_KEY, whichever EMBEDDING_PROVIDER selects) —
# the single-vendor case. That fallback does NOT apply when GENERATION_BASE_URL
# is set: a self-hosted endpoint is never handed a hosted vendor's production
# key, it gets a placeholder. Set this explicitly if your self-hosted server
# requires auth (e.g. llama.cpp / vLLM `--api-key`).
# GENERATION_API_KEY=

# What the generation-time TRI (Taxpayer Return Information, IRC §7216)
# pre-flight does when it matches the assembled prompt.
#   block — refuse the request (HTTP 422); no provider call is made.
#   warn  — proceed, and log the matched patterns (marker generation.tri.warned).
#   off   — skip the scan entirely. This also disables the identifier guard
#           below, so it is only correct where no third-party disclosure
#           occurs (e.g. self-hosted generation).
#
# THIS SETTING GOVERNS THE CONTEXTUAL PATTERNS ONLY. SSN and EIN are identifying
# and always block, whatever is set here (short of `off`).
#
# Default is `warn` for the contextual half, and that default is deliberate.
# Patterns like `tax-form+amount` match any text naming an IRS form within ~50
# characters of a dollar figure — which is exactly what a procedure explaining
# how to prepare that form looks like. A full screen of the TWK corpus
# (858 documents, 2026-08-01) matched `tax-form+amount` on 316 documents (36.8%),
# and the inspected hits were SOPs. Because one prompt bundles ~12 chunks,
# `block` turns routine tax-procedure questions into hard errors.
#
# The same screen matched SSN/EIN on 24 documents — 21 of them chunked and
# retrievable — one holding 260 distinct SSN-shaped values. That is why the
# identifying patterns are not tunable here.
#
# Set `block` when real client tax documents are in the indexed corpus.
# COMPLIANCE_MODE=client-data forces `block` regardless of what is set here.
GENERATION_TRI_POLICY=warn

# ============================================================================
# Web app sign-in (Auth.js + Microsoft Entra ID) — apps/web only
# A SEPARATE Entra app registration from MS_TENANT_ID/MS_CLIENT_ID/
# MS_CLIENT_SECRET above (those are application/client-credentials
# permissions for the SharePoint/Outlook connectors; this is a delegated,
# authorization-code+PKCE registration for interactive user sign-in).
# Requires groupMembershipClaims: "SecurityGroup" set in this app
# registration's manifest so the `groups` claim is populated on sign-in.
# ============================================================================
WEB_PORT=3002
AUTH_ENTRA_CLIENT_ID=
AUTH_ENTRA_CLIENT_SECRET=
AUTH_ENTRA_TENANT_ID=

# REQUIRED by Auth.js v5 (next-auth@5.0.0-beta.31, apps/web/src/lib/auth.ts).
# Encrypts/signs the session JWE cookie. There is no dev fallback in
# production — Auth.js throws MissingSecret at startup/first request if this
# is unset and NODE_ENV=production. Generate one with the standard Auth.js
# tooling command `npx auth secret`, or any cryptographically random 32+ byte
# value (e.g. `openssl rand -base64 33`). Store in a real secret manager.
AUTH_SECRET=

# Needed when the web app sits behind a reverse proxy / PaaS router (e.g.
# Railway) so Auth.js constructs the OAuth callback `redirect_uri` from the
# real public URL rather than an internal one. Set AUTH_URL to the app's
# public base URL (e.g. https://rag.example.com), OR set
# AUTH_TRUST_HOST=true to have Auth.js trust the proxy's forwarded host
# headers instead. Only one of the two is required; misconfiguring both
# results in Entra ID rejecting the callback with a redirect_uri mismatch.
AUTH_URL=
AUTH_TRUST_HOST=

# ============================================================================
# Emergency rollback (web app only) — DELIBERATELY TEMPORARY
# If Entra ID sign-in breaks in production (misconfigured redirect URI,
# expired client secret, tenant issue), set WEB_AUTH_MODE=static-fallback to
# revert every user to one shared static token while the issue is fixed.
# Remove both vars once the Entra ID rollout has been stable for a defined
# period — this is a safety net, not a permanent dual-mode feature.
# ============================================================================
WEB_AUTH_MODE=entra
RAG_API_STATIC_FALLBACK_TOKEN=

# ============================================================================
# Admin role gate (web app only)
# AAD security group object id whose members can grant/revoke client access
# via /admin/access. No DB-backed roles table — this group is the single
# source of truth, consistent with how AAD groups already govern access for
# the SharePoint/Outlook connectors.
# ============================================================================
RAG_ADMINS_GROUP_ID=

# ============================================================================
# Documentation-gap digest (Phase 4 of docs/PLAN-KB-GOVERNANCE-AND-USAGE-ANALYTICS.md)
# The first recurring (pg-boss scheduled) job in this codebase. Periodically
# scans audit_log for zero-result/weak-confidence /ask and /search queries and
# logs one structured summary line (marker: "docs.gap_digest.summary") — no
# report table, no UI. Registered on every api/mcp/worker boot (idempotent
# upsert into pgboss.schedule), so any of those processes picks up a changed
# schedule after redeploy.
# ============================================================================
# 5-field crontab expression. Default: every Monday at 06:00 in DOCS_GAP_DIGEST_TZ.
DOCS_GAP_DIGEST_CRON=0 6 * * 1
# IANA timezone the cron expression above is evaluated in.
DOCS_GAP_DIGEST_TZ=UTC
# Retrieval score (0-1) below which a result counts as "weak"/low-confidence
# for the digest. Tune to match your embedding/reranking setup.
DOCS_GAP_DIGEST_MIN_SCORE=0.3

# ============================================================================
# Teams bot (apps/teams-bot)
# Reuses DATABASE_URL, RAG_API_URL, and INTERNAL_SCOPE_JWT_SECRET (the same
# secret the API verifies scope-assertion tokens against, see the
# INTERNAL_SCOPE_JWT_SECRET block above) from this file — no separate copies.
# ============================================================================
# Entra app registration backing the Teams bot (Bot Framework channel
# registration). App registrations: https://entra.microsoft.com
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
# SSO scope exposed by the bot's Entra app registration for on-behalf-of
# token exchange (Teams SSO), e.g. api://botid-<MICROSOFT_APP_ID>/access_as_user.
BOT_ENTRA_SSO_SCOPE=
# Name of the OAuth Connection Setting configured on the Azure Bot resource
# (Azure Bot -> Settings -> Configuration -> OAuth Connection Settings).
# This is the *setting's name* (e.g. "kb-bot-sso"), NOT the SSO scope URI
# above — the Bot Framework token service keys getUserToken/getSignInResource/
# exchangeToken calls on this name. Required.
BOT_OAUTH_CONNECTION_NAME=
# HTTP port the bot's Bot Framework adapter listens on. Defaults to 3978
# (the Bot Framework Emulator/Teams convention) if unset.
PORT=3978

# ============================================================================
# Audit-log shipping (off-host sink for audit_log rows)
# Default: none (audit_log rows stay in this Postgres only; nothing is shipped
# off-host). Set provider=webhook to POST rows as JSON to any generic HTTPS
# collector (Datadog, Splunk, Papertrail, etc.) on a recurring (pg-boss
# scheduled) cursor-based job — never write-time, so an external vendor's
# availability/latency can never affect the /ask or /search hot path.
#
# Rows carry real per-user identity (principalSubject, a real AAD object id),
# so every POST is gated by EgressPolicy/EGRESS_ALLOWED_HOSTS — the SAME
# compliance control that already governs LLM/embedding egress. Add the
# webhook's host to EGRESS_ALLOWED_HOSTS or every ship attempt throws.
# ============================================================================
AUDIT_SINK_PROVIDER=none
AUDIT_SINK_WEBHOOK_URL=
# Optional bearer token sent as `Authorization: Bearer <token>`.
AUDIT_SINK_WEBHOOK_TOKEN=
# 5-field crontab expression for the shipping job. Default: every hour.
AUDIT_SINK_CRON=0 * * * *
# IANA timezone the cron expression above is evaluated in.
AUDIT_SINK_TZ=UTC
