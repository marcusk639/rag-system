# Copy this file to .env and fill in values.
# (Hosted Claude Code cannot create .env files for you — copy manually.)

# Pino log level for all Node services (api, mcp, worker): trace|debug|info|warn|error
LOG_LEVEL=info

# ============================================================================
# Database
# ============================================================================
DATABASE_URL=postgres://rag:rag@localhost:5432/rag
PG_BOSS_SCHEMA=pgboss
# Optional TLS for the app's Postgres pool: require (verify cert) | no-verify
# (TLS but accept managed/self-signed certs) | disable/unset (no explicit pool
# TLS). In production, if neither this nor ?sslmode=require is set, startup logs
# a warning. For uniform coverage (pool + pg-boss + migrations) prefer adding
# ?sslmode=require to DATABASE_URL instead of this flag.
DATABASE_SSL=

# ============================================================================
# Embedding Provider
#
# COMPLIANCE MODE (CPA/§7216): set EMBEDDING_PROVIDER=local so embeddings are
# generated on-process via ONNX (no TRI egress, satisfies CR-1 and CR-3).
#
# local   — @huggingface/transformers, ONNX runtime, zero network egress.
#            Default model: Xenova/bge-base-en-v1.5 (768-d). ~430 MB on first
#            startup; run `npx tsx scripts/warm-model.ts` during image build to
#            pre-warm. Subsequent runs use HF_CACHE_DIR (no download).
# gemini  — Gemini embedding API (768-d via outputDimensionality). Requires
#            GEMINI_API_KEY. Note: text-embedding-004 is retired; use
#            gemini-embedding-001.
# openai  — OpenAI text-embedding-3-small (1536-d). Requires OPENAI_API_KEY.
# ============================================================================
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Local provider only — override the HuggingFace model cache directory.
# Defaults to ~/.cache/huggingface. Set to a shared path on deployment VMs to
# avoid re-downloading weights on every deploy.
HF_CACHE_DIR=

# Provider API keys (only the configured provider's key is required)
GEMINI_API_KEY=
OPENAI_API_KEY=

# ============================================================================
# Document Parser Sidecar
# ============================================================================
PARSER_URL=http://localhost:8000
PARSER_TIMEOUT_MS=60000
# Hard cap on upload size accepted by the parser sidecar (bytes). Default 100 MB.
PARSER_MAX_UPLOAD_BYTES=104857600
# Optional shared secret for the parser sidecar. When set, the sidecar requires
# an X-Parser-Token header matching this value and the Node client sends it.
# Leave blank for single-host dev (the loopback bind is the only guard).
# REQUIRED (fail-loud at startup) when NODE_ENV=production — every service
# (api/mcp/worker) AND the parser sidecar must share the same value, or the
# parser returns 401. Generate with: openssl rand -hex 32
PARSER_SECRET=

# ============================================================================
# Observability — Error Reporting (Sentry-compatible)
# Set SENTRY_DSN to enable error capture in api, mcp, worker, and parser.
# Safe to omit in dev/CI. Find your DSN at: https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=

# ============================================================================
# Object Storage (original document bytes for downloadable citations)
# Default: none (originals are NOT stored; the download route returns 404).
# Set provider=s3 to persist originals to any S3-compatible store
# (AWS S3, Railway buckets, MinIO, GCS S3-mode) so users can download the
# exact cited file. Switching this on only affects documents synced afterward.
# ============================================================================
OBJECT_STORE_PROVIDER=none
OBJECT_STORE_BUCKET=
# Custom endpoint for non-AWS stores (e.g. a Railway bucket or MinIO URL).
# Leave blank for real AWS S3.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
# Path-style addressing — required by most non-AWS S3-compatible stores.
OBJECT_STORE_FORCE_PATH_STYLE=true
# Optional prefix applied to every stored object key (e.g. "originals/").
OBJECT_STORE_KEY_PREFIX=

# ============================================================================
# API Server
# ============================================================================
API_PORT=3000
API_HOST=0.0.0.0
# Bearer tokens authorized to call the API (comma-separated).
# Each PLAIN token here resolves to an ADMIN / all-access principal:
# retrieval is UNRESTRICTED (sees the whole corpus). Reserve these for
# admin/service callers. Backward-compatible with the pre-ACL behavior.
API_TOKENS=dev-token-change-me

# SCOPED principals (per-token sourceId access control) — OPT-IN confidentiality
# boundary. JSON array of {"token","allowedSourceIds":[...]}. A token listed
# here is a valid bearer token but retrieval is ENFORCED to ONLY its
# allowedSourceIds (and CANNOT see anything else); an empty array => the token
# can read NOTHING (fail closed). Scoped wins over API_TOKENS if a token appears
# in both (least privilege). Used by both the HTTP API and the MCP HTTP
# transport. Leave blank for no scoped principals. Example:
# API_PRINCIPALS=[{"token":"staff-a-token","allowedSourceIds":["<source-uuid-1>","<source-uuid-2>"]}]
# Grant explicit all-corpus admin with {"token":"...","allowedSourceIds":[],"isAdmin":true}.
API_PRINCIPALS=
# OPT-IN least-privilege enforcement. When true, plain API_TOKENS no longer grant
# admin — they authenticate but resolve to deny-all; admin must be granted
# explicitly via an isAdmin principal above. Default false keeps API_TOKENS=admin
# (backward compatible). Recommended: set true in production once admins are
# moved to isAdmin principals.
API_ENFORCE_SCOPING=false

# ============================================================================
# Authentication provider (pluggable, IdP-NEUTRAL)
# ============================================================================
# Selects how bearer credentials are authenticated. The core is provider-neutral:
# everything below is DEPLOYMENT config — no IdP is hardcoded.
#   static-token  Only API_TOKENS / API_PRINCIPALS (legacy behavior).
#   oidc          Only OIDC JWTs (federated identity).
#   composite     Both: static tokens AND OIDC JWTs (default). Static is tried
#                 first; OIDC second. With no OIDC_* vars set, composite behaves
#                 exactly like static-token (backward compatible).
AUTH_PROVIDER=composite

# --- Generic OIDC settings (used when AUTH_PROVIDER is oidc or composite) ---
# Leave OIDC_ISSUER/OIDC_AUDIENCE blank to disable OIDC under composite. Setting
# AUTH_PROVIDER=oidc without these fails loud at startup.
#
# OIDC_ISSUER     Expected `iss` claim — the IdP issuer URL.
# OIDC_AUDIENCE   Expected `aud` claim — THIS API's app/client id at the IdP.
# OIDC_JWKS_URI   JWKS endpoint. Optional; if blank we derive
#                 <issuer>/.well-known/jwks.json. Most IdPs use a custom path,
#                 so set this explicitly when in doubt.
# OIDC_CLAIM      Token claim carrying the caller's group/role ids. May be a
#                 string or string[] in the token. Default: groups
# OIDC_SCOPE_MAP  JSON array mapping a claim VALUE to allowed source ids. The
#                 union across all matching entries is the caller's scope. A
#                 token with no matching entry sees NOTHING (fail closed).
# OIDC_ADMIN_CLAIMS  Claim values granting ADMIN / all-access. JSON array or CSV.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_CLAIM=groups
OIDC_SCOPE_MAP=
OIDC_ADMIN_CLAIMS=
#
# --- Example: Microsoft Entra ID (Azure AD) ---
# Entra is just one OIDC IdP; the core has zero Entra-specific code. To wire it,
# set (replace <tenant-id> and <api-client-id>):
#   OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#   OIDC_AUDIENCE=<api-client-id>
#   OIDC_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
#   OIDC_CLAIM=groups
#   OIDC_SCOPE_MAP=[{"claim":"<entra-group-object-id>","allowedSourceIds":["<source-uuid-1>"]}]
#   OIDC_ADMIN_CLAIMS=["<entra-admin-group-object-id>"]

# ============================================================================
# MCP Server
# ============================================================================
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3001
# Comma-separated allowlist of Origins for the MCP HTTP transport (DNS-rebinding
# protection). Leave blank to allow all origins (development only).
MCP_ALLOWED_ORIGINS=
# Max concurrent MCP sessions held in memory on the HTTP transport.
MCP_MAX_SESSIONS=1000

# ============================================================================
# Worker
# ============================================================================
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=2000

# ============================================================================
# Microsoft (SharePoint + Outlook)
# App registration: https://entra.microsoft.com → App registrations
# Needs Application permissions: Sites.Read.All, Files.Read.All, Mail.Read
# ============================================================================
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ============================================================================
# Google (Drive + Gmail)
# Service account JSON OR OAuth client credentials.
# For Workspace-wide access, use a service account with domain-wide delegation.
# ============================================================================
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or OAuth:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ============================================================================
# Retrieval tuning
# ============================================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# Number of chunks retrieved per query (default 12). Larger = more context for
# the generator, more tokens. Pair with GENERATION_MAX_OUTPUT_TOKENS.
DEFAULT_TOP_K=12
HYBRID_DENSE_WEIGHT=0.7
HYBRID_SPARSE_WEIGHT=0.3
# Per-document diversity cap: at most N chunks from any single document reach
# the generator, so one long file can't crowd out other sources. 0 disables.
MAX_CHUNKS_PER_DOCUMENT=3

# ============================================================================
# Optional: reranking stage (Phase F)
# After hybrid RRF fusion, an optional cross-encoder reranker re-orders the
# over-fetched candidate pool by true query relevance before the top-K reaches
# the generator. `none` (default) is a pass-through — deployments opt in.
# ============================================================================
# none | cohere | jina (llm reserved, not yet implemented)
RERANK_PROVIDER=none
# Provider model (defaults: cohere=rerank-v3.5, jina=jina-reranker-v2-base-multilingual)
RERANK_MODEL=
# API key for the hosted reranker (required when provider != none)
RERANK_API_KEY=
# Candidates pulled from hybrid search = RERANK_POOL_MULTIPLIER × topK
RERANK_POOL_MULTIPLIER=5

# ============================================================================
# Compliance enforcement mode (§7216 / CPA deployment)
#
# none         — default; no extra startup checks. Use in dev and CI.
# client-data  — service refuses to boot unless docs/compliance/vendor-dpa-<vendor>.md
#                exists. Use in any environment where real firm/taxpayer documents
#                may enter the pipeline. Create the DPA file first
#                (see docs/compliance/README.md), then set this.
# ============================================================================
COMPLIANCE_MODE=none

# ============================================================================
# Egress allow-list (CR-1 / §7216 compliance)
# Comma-separated hostnames that generation calls are permitted to reach.
# If empty, all external generation calls are blocked (local-only mode).
# Example: generativelanguage.googleapis.com,api.openai.com
# In COMPLIANCE_MODE=client-data leave blank unless a signed DPA is on file for
# each listed host (see docs/compliance/).
# ============================================================================
EGRESS_ALLOWED_HOSTS=generativelanguage.googleapis.com,api.openai.com

# ============================================================================
# Optional: generation model for /ask endpoint
# ============================================================================
GENERATION_PROVIDER=gemini
GENERATION_MODEL=gemini-2.5-flash
# Upper bound on generated answer length. Generous so substantive, multi-source
# answers aren't truncated at provider defaults.
GENERATION_MAX_OUTPUT_TOKENS=2048

# ============================================================================
# Documentation-gap digest (Phase 4 of docs/PLAN-KB-GOVERNANCE-AND-USAGE-ANALYTICS.md)
# The first recurring (pg-boss scheduled) job in this codebase. Periodically
# scans audit_log for zero-result/weak-confidence /ask and /search queries and
# logs one structured summary line (marker: "docs.gap_digest.summary") — no
# report table, no UI. Registered on every api/mcp/worker boot (idempotent
# upsert into pgboss.schedule), so any of those processes picks up a changed
# schedule after redeploy.
# ============================================================================
# 5-field crontab expression. Default: every Monday at 06:00 in DOCS_GAP_DIGEST_TZ.
DOCS_GAP_DIGEST_CRON=0 6 * * 1
# IANA timezone the cron expression above is evaluated in.
DOCS_GAP_DIGEST_TZ=UTC
# Retrieval score (0-1) below which a result counts as "weak"/low-confidence
# for the digest. Tune to match your embedding/reranking setup.
DOCS_GAP_DIGEST_MIN_SCORE=0.3
