{
  "name": "rag-system",
  "version": "0.1.0",
  "private": true,
  "description": "Generic RAG service with multi-source ingestion, MCP access, and pgvector storage",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* run build",
    "dev:api": "pnpm --filter @rag/api dev",
    "dev:mcp": "pnpm --filter @rag/mcp dev",
    "dev:worker": "pnpm --filter @rag/worker dev",
    "db:generate": "pnpm --filter @rag/db generate",
    "db:migrate": "pnpm --filter @rag/db migrate",
    "db:studio": "pnpm --filter @rag/db studio",
    "gen:parser-types": "openapi-typescript http://localhost:8000/openapi.json -o packages/core/src/parser-types.generated.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:fresh": "pnpm -r build && pnpm -r --filter '!@rag/e2e' run test",
    "test:coverage": "vitest run --coverage",
    "e2e": "pnpm --filter @rag/e2e test",
    "eval": "pnpm --filter @rag/e2e run eval",
    "eval:real": "pnpm --filter @rag/e2e run eval:real",
    "eval:gold": "pnpm --filter @rag/e2e run eval:gold",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "prepare": "husky"
  },
  "devDependencies": {
    "@google/genai": "^1.7.0",
    "@rag/core": "workspace:*",
    "@rag/db": "workspace:*",
    "@rag/rag": "workspace:*",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yml,yaml}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix --no-warn-ignored"
  },
  "pnpm": {
    "overrides": {
      "vite@<6.4.3": "^6.4.3",
      "js-yaml@>=3 <3.15.2": "^3.15.2",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "postcss@<8.5.18": "^8.5.18",
      "brace-expansion@>=1 <1.1.20": "^1.1.20",
      "brace-expansion@>=2 <2.1.6": "^2.1.6",
      "brace-expansion@>=5 <5.0.11": "^5.0.11",
      "nanoid@>=3 <3.3.18": "^3.3.18",
      "tar@<7.5.21": "^7.5.21",
      "axios@<1.20.0": "^1.20.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "proxy-addr@<2.0.8": "^2.0.8",
      "sharp@<0.35.5": "^0.35.5",
      "follow-redirects@<1.16.1": "^1.16.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
