    "@huggingface/transformers": "^3.5.2",
    "@rag/core": "workspace:*",
    "@rag/db": "workspace:*",
    "gpt-tokenizer": "^4.1.0",
    "openai": "^7.39.0",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@rag/test-fixtures": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  }
}
