# Server-only config for the BFF route handlers. NEVER prefix any of these
# with NEXT_PUBLIC_ — the browser only ever talks to same-origin /api/*
# routes; every credential below stays server-side.

# ── Base RAG API connection ─────────────────────────────────────────────────
# Base URL of the RAG HTTP API (no trailing slash), e.g. https://rag-api.example.com
RAG_API_URL=http://localhost:3000

# ── Direct database connection ──────────────────────────────────────────────
# Despite being a BFF for chat/search (which proxy to RAG_API_URL above), this
# app also connects to Postgres directly for scope resolution and the admin
# UI (/admin/access, /admin/docs-gap-digest) — see src/lib/db.ts. Same
# database the RAG API/worker use.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
# "disable" for local/compose (no TLS), "require" for most managed Postgres
# (e.g. Railway) — must match how the RAG API/worker connect to the same DB.
DATABASE_SSL=disable

# ── NextAuth (Auth.js v5) session signing ───────────────────────────────────
# Signs/encrypts the user's session cookie. Required — NextAuth throws
# MissingSecret at boot without it. Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Microsoft Entra ID (Office 365) SSO — user-facing sign-in ───────────────
# A dedicated Azure AD app registration for THIS web app's login flow (do not
# reuse the MS_* Graph API credentials below — different app, different
# redirect URI, different permission scopes: user-facing OpenID Connect here,
# server-side application permissions there).
AUTH_ENTRA_CLIENT_ID=
AUTH_ENTRA_CLIENT_SECRET=
AUTH_ENTRA_TENANT_ID=

# ── Per-user confidentiality boundary ───────────────────────────────────────
# Signs the short-lived (60s) scope-assertion JWT this app mints per request,
# proving to the RAG API which sources the signed-in user may see. Must
# match INTERNAL_SCOPE_JWT_SECRETS on the RAG API/MCP side (that side accepts
# a comma/JSON-array list for rotation; this side signs with one value).
# Must be at least 64 characters (256 bits of entropy for HS256).
# Generate with: openssl rand -hex 32
INTERNAL_SCOPE_JWT_SECRET=

# ── Microsoft Graph API — admin-group membership check ──────────────────────
# A SEPARATE credential set (server-side application permissions, not user
# login) used only to check whether the signed-in user belongs to the admin
# security group. If the worker's SharePoint connector is already configured
# in this deployment, these three values are typically the same ones already
# set there — reuse them rather than registering a second app, unless you
# have a reason to keep them separate.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Object ID (not display name) of the Entra security group whose members see
# the admin UI (/admin/access, /admin/docs-gap-digest). Find it in the Azure
# portal under the group's Overview page.
RAG_ADMINS_GROUP_ID=

# ── Emergency fallback (deliberately temporary — see src/middleware.ts) ─────
# WEB_AUTH_MODE=static-fallback bypasses per-user Entra ID sign-in entirely,
# authorizing every request with ONE shared static token instead. This is an
# emergency-only rollback for when Entra ID sign-in itself is broken in
# production — NOT a normal operating mode. Leave WEB_AUTH_MODE unset (the
# default) for normal per-user operation. If you ever set it to
# "static-fallback", also set RAG_API_STATIC_FALLBACK_TOKEN below to a
# SCOPED API_PRINCIPALS token (least privilege, never an admin API_TOKENS
# token), and revert to normal mode as soon as Entra ID is fixed.
WEB_AUTH_MODE=
RAG_API_STATIC_FALLBACK_TOKEN=
