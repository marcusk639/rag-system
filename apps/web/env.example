# Server-only config for the BFF route handlers. NEVER prefix with NEXT_PUBLIC_.
# The browser only ever talks to same-origin /api/* routes; the token stays here.

# Base URL of the RAG HTTP API (no trailing slash), e.g. https://rag-api.example.com
RAG_API_URL=http://localhost:3000

# Bearer token for the RAG API. Use a SCOPED API_PRINCIPALS token (least privilege),
# NOT an admin API_TOKENS token.
#
# Uploads (POST /api/upload -> RAG POST /sources/:id/documents) additionally
# require: (1) this token's scope to include the target `custom` source, and
# (2) the RAG API to have an object store configured (OBJECT_STORE_PROVIDER=s3),
# since the original bytes are persisted for downloadable citations.
RAG_API_TOKEN=
